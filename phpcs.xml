<?xml version="1.0"?>
<ruleset name="NpcinkAIClientAdapter">
	<description>WordPress Coding Standards for Adapter runtime PHP.</description>

	<file>includes</file>
	<file>npcink-ai-client-adapter.php</file>
	<file>uninstall.php</file>
	<file>scripts/check-wordpress-org-review-rules.php</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Core">
		<!-- PSR-style class filenames back the plugin autoloader; WordPress
			hyphenated class-file naming would break it. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="npcink-ai-client-adapter"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>

	<config name="testVersion" value="8.0-"/>
</ruleset>
