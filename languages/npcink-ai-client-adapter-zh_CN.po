#. Description of the plugin
#: npcink-ai-client-adapter.php
msgid ""
"Thin AI client adapter for Npcink Governance Core and WordPress Abilities "
"execution."
msgstr "用于 Npcink 治理核心和 WordPress 能力执行的轻量 AI 客户端适配器。"

#. Author of the plugin
#: npcink-ai-client-adapter.php
msgid "Npcink"
msgstr "Npcink"

#: includes/Admin/Connection_Page.php:50
msgid "Adapter"
msgstr "渠道适配器"

#: includes/Admin/Connection_Page.php:68 includes/Admin/Connection_Page.php:69
#: includes/Admin/Connection_Page.php:399
msgid "Approve Npcink Client"
msgstr "批准 Npcink 客户端"

#: includes/Admin/Connection_Page.php:139
